# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES CONFIGURATION (E-BOOK MARKETPLACE)
# ------------------------------------------------------------------------------

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Database (PostgreSQL via Docker Compose on port 9432)
POSTGRES_USER=ebook_user
POSTGRES_PASSWORD=ebook_pass_secure
POSTGRES_DB=ebook_marketplace
DATABASE_URL=postgresql://ebook_user:ebook_pass_secure@localhost:9432/ebook_marketplace?schema=public

# Object Storage (MinIO S3 Compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_secure
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_secret_secure
STORAGE_BUCKET_PRIVATE=ebook-private-assets
STORAGE_BUCKET_PUBLIC=ebook-public-covers

# Redis Cache & Message Queues
REDIS_URL=redis://localhost:6379

# Authentication & Session
SESSION_COOKIE_NAME=ebook_session
SESSION_MAX_AGE_SECONDS=604800

# Payment Gateways (Sandbox / Test keys)
CHAPA_PUBLIC_KEY=CHASECK_TEST-sample_public_key
CHAPA_SECRET_KEY=CHASECK_TEST-sample_secret_key
CHAPA_WEBHOOK_SECRET=sample_webhook_secret_key

TELEBIRR_APP_ID=sample_telebirr_app_id
TELEBIRR_APP_KEY=sample_telebirr_app_key
TELEBIRR_SHORT_CODE=sample_short_code
TELEBIRR_PUBLIC_KEY=sample_telebirr_public_key

STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_webhook_secret

# Default Platform Commission (15%)
DEFAULT_COMMISSION_RATE=0.1500
